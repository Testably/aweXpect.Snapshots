<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="aweXpect" Version="3.4.0"/>
		<PackageVersion Include="aweXpect.Core" Version="3.4.0"/>
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0"/>
	</ItemGroup>
	<!--
	    DiffEngine 13.0.2 is the last version for netstandard2.0. The other targets use the current version, as its API
	    is not binary compatible with 13.0.2 and e.g. Verify brings it along.
	-->
	<ItemGroup>
		<PackageVersion Include="DiffEngine" Version="13.0.2" Condition="'$(TargetFramework)' == 'netstandard2.0'"/>
		<PackageVersion Include="DiffEngine" Version="20.8.2" Condition="'$(TargetFramework)' != 'netstandard2.0'"/>
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Nullable" Version="1.3.1"/>
		<PackageVersion Include="IsExternalInit" Version="1.0.3"/>
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Fallout.Common" Version="10.4.0"/>
		<PackageVersion Include="Fallout.Components" Version="10.4.0"/>
		<PackageVersion Include="LibGit2Sharp" Version="0.32.0"/>
		<PackageVersion Include="SharpCompress" Version="0.50.5"/>
		<PackageVersion Include="NuGet.Frameworks" Version="7.9.0"/>
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Meziantou.Analyzer" Version="2.0.163"/>
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8"/>
		<PackageVersion Include="NUnit" Version="5.0.0"/>
		<PackageVersion Include="NUnit3TestAdapter" Version="6.3.1"/>
		<PackageVersion Include="NUnit.Analyzers" Version="4.15.0"/>
		<PackageVersion Include="xunit" Version="2.9.3"/>
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
		<PackageVersion Include="coverlet.collector" Version="10.1.0"/>
	</ItemGroup>
</Project>
